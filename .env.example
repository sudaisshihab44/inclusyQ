# Site URL used for canonical, Open Graph and sitemap URLs.
# Production: Use your actual domain (required for proper SEO)
NEXT_PUBLIC_SITE_URL=https://inclusyq.online

# Option A: send demo requests by email through Resend.
RESEND_API_KEY=
DEMO_TO_EMAIL=info@inclusyq.online
DEMO_FROM_EMAIL="InclusyQ Website <website@your-verified-domain.com>"

# Option B: forward demo requests to a CRM or automation webhook.
# If set, this takes precedence over Resend.
DEMO_WEBHOOK_URL=
DEMO_WEBHOOK_TOKEN=
